#!name=知乎 IPv6 拦截（精确段）
#!desc=只拦截知乎使用的 IPv6 网段。知乎 App 拿到 AAAA 后会直连 IPv6，此时 Shadowrocket 只能看到 IP、无法按域名解密，Map Local 与 Script 全部失效。此模块只含 Rule（不含 MITM/Script），可与其它模块共存。微信使用 2408:8756 / 2408:80f1 / 240e:ff 等段，不受影响。
#!author=sr-adblock
#!system=ios
#!category=工具
#!tag=IPv6,知乎

[Rule]
IP-CIDR6,2408:875c::/32,REJECT
IP-CIDR6,240e:97c:39::/48,REJECT
IP-CIDR6,240e:97c:3a::/48,REJECT
IP-CIDR6,240e:951:2c10::/48,REJECT
IP-CIDR6,240e:97d:2008:4::/64,REJECT
IP-CIDR6,240e:978:d04::/48,REJECT
